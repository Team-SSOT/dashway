{
  "name": "@dashway/rich-text",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./react": {
      "import": "./src/react.ts",
      "types": "./src/react.ts"
    },
    "./render": {
      "import": "./src/render/index.ts",
      "types": "./src/render/index.ts"
    },
    "./editor": {
      "import": "./src/editor/index.ts",
      "types": "./src/editor/index.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsgo --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@dashway/ui": "workspace:*",
    "@lexical/code": "0.43.0",
    "@lexical/html": "0.43.0",
    "@lexical/link": "0.43.0",
    "@lexical/list": "0.43.0",
    "@lexical/markdown": "0.43.0",
    "@lexical/react": "0.43.0",
    "@lexical/rich-text": "0.43.0",
    "lexical": "0.43.0",
    "lucide-react": "^0.488.0",
    "shiki": "^3.23.0"
  },
  "devDependencies": {
    "@types/react": "^19",
    "jsdom": "^29.0.2",
    "typescript": "^5",
    "vitest": "^4.1.5"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
