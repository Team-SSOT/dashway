{
  "name": "dashway",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev": "pnpm --filter @dashway/landing dev",
    "dev:desktop": "pnpm --filter @dashway/desktop dev",
    "build": "pnpm --filter @dashway/landing build",
    "build:packages": "pnpm --filter './packages/**' build",
    "build:desktop": "pnpm build:packages && pnpm --filter @dashway/desktop build",
    "make:desktop": "pnpm build:packages && pnpm --filter @dashway/desktop make",
    "start": "pnpm --filter @dashway/landing start",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "pnpm -r --parallel typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.8",
    "@typescript/native-preview": "7.0.0-dev.20260318.1"
  }
}
