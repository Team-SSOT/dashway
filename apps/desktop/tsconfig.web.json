{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "composite": true,
    "outDir": "./out",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "paths": {
      "@/*": ["./renderer/src/*"]
    },
    "types": ["vite/client"]
  },
  "include": ["renderer/src/**/*.ts", "renderer/src/**/*.tsx", "electron/preload/types/**/*.d.ts"]
}
