    "@dashway/shell-runtime": "workspace:*",
    "@dashway/ui": "workspace:*",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-relay": "^19.0.0",
    "react-router": "^7.5.0",
    "react-router-dom": "^7.5.0",
    "relay-runtime": "^19.0.0",
    "zod": "^3.24",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/maker-dmg": "^7.11.1",
