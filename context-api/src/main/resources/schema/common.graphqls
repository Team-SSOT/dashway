schema {
  query: Query
  mutation: Mutation
}

scalar Long
scalar DateTime

type MutationError {
  code: MutationErrorCode!
  message: String!
}

type PageInfo {
  page: Int!
  size: Int!
  totalElements: Int!
  totalPages: Int!
}

enum MutationErrorCode {
  NOT_FOUND
  VALIDATION_ERROR
  DUPLICATE_MEMBER_EMAIL
  TEAM_NOT_EMPTY
  APP_ALREADY_DISABLED
  MEMBERSHIP_ALREADY_EXISTS
  MEMBERSHIP_NOT_FOUND
  UNAUTHENTICATED
  FORBIDDEN
  INVALID_CREDENTIALS
  INVALID_REFRESH_TOKEN
}
