extend type Query {
  search(input: SearchInput!): SearchResult!
}

input SearchInput {
  query: String!
  sources: [SourceType!]
  appIds: [String!]
  page: Int
  size: Int
}

enum SourceType {
  MEMBER
  TEAM
  APP
}

enum SourceErrorCode {
  TIMEOUT
  UNAVAILABLE
  UNAUTHORIZED
  INVALID_RESPONSE
  UNKNOWN
}

type SearchResult {
  items: [SearchItem!]!
  pageInfo: PageInfo!
  sourceErrors: [SearchSourceError!]!
}

type SearchSourceError {
  sourceType: SourceType!
  code: SourceErrorCode!
  message: String!
}

interface SearchItem {
  sourceId: String!
  sources: SourceType!
  title: String!
  createdDatetime: DateTime!
}

type MemberSearchItem implements SearchItem {
  sourceId: String!
  sources: SourceType!
  title: String!
  name: String!
  email: String!
  createdDatetime: DateTime!
}

type TeamSearchItem implements SearchItem {
  sourceId: String!
  sources: SourceType!
  title: String!
  name: String!
  createdDatetime: DateTime!
}

type AppSearchItem implements SearchItem {
  sourceId: String!
  sources: SourceType!
  title: String!
  content: String!
  rawPayload: JSON!
  createdDatetime: DateTime!
}
