type Query {
  members(page: Int!, size: Int!): MemberPage!
  member(id: Long!): Member
}

type Mutation {
  registerMember(input: RegisterMemberInput!, file: Upload): Member!
  updateMember(input: UpdateMemberInput!, file: Upload): Member!
}

type Member {
  id: Long!
  name: String!
  email: String!
  profileImgPath: String
  authorities: [Authority!]!
  isEnabled: Boolean!
  createdDatetime: DateTime!
}

type MemberPage {
  members: [Member!]!
  pageInfo: PageInfo!
}

input RegisterMemberInput {
  name: String!
  email: String!
  password: String!
  isEnabled: Boolean!
  teamId: Long
  authorityIds: [Int!]
}

input UpdateMemberInput {
  id: Long!
  name: String
  isEnabled: Boolean
  authorityIds: [Int!]
}
