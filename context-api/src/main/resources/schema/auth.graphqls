#extend type Query {
  #인증
  #검색(사용자용)
  #검색(LLM용)
#}

extend type Mutation {
  login(input: LoginInput!): LoginPayload!
  logout: Boolean!
  refresh: LoginPayload!
}

type AuthToken {
  accessToken: String!
}

type LoginPayload {
  member: Member!
  tokens: AuthToken!
}

input LoginInput {
  email: String!
  password: String!
}

type Authority {
  id: Int!
  name: String!
}
