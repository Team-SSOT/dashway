extend type Query {
  apps(page: Int!, size: Int!): AppPage!
  app(id: String!): App
}

extend type Mutation {
  registerApp(input: RegisterAppInput!): App
  deactivateApp(input: DeactivateAppInput!): App
}

type App {
  id: String!
  name: String!
  enabled: Boolean!
  createdDatetime: DateTime!
}

type AppPage {
  apps: [App!]!
  pageInfo: PageInfo!
}

input RegisterAppInput {
  name: String!
  enabled: Boolean = true
}

input DeactivateAppInput {
  id: String!
}
