extend type Query {
  apps(page: Int!, size: Int!): AppPage!
  app(id: String!): App
}

extend type Mutation {
  activateApp(input: ActivateAppInput!): App
  deactivateApp(input: DeactivateAppInput!): App
}

type App {
  id: String!
  name: String!
  port: Int!
  isEnabled: Boolean!
  createdDatetime: DateTime!
}

type AppPage {
  apps: [App!]!
  pageInfo: PageInfo!
}

input ActivateAppInput {
  id: String!
}

input DeactivateAppInput {
  id: String!
}
